# Add to the existing app environment. Keep all existing variables unchanged.
# Shared infrastructure: same Supabase project and existing admin authentication.
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# Prices are fixed in src/lib/us-soulmate-prices.ts. Checkout is always enabled.
# US Stripe always uses live keys; there is no environment mode switch.
NEXT_PUBLIC_US_SOULMATE_STRIPE_PUBLISHABLE_KEY=
US_SOULMATE_STRIPE_SECRET_KEY=
US_SOULMATE_STRIPE_WEBHOOK_SECRET=
# Independent random secret of at least 32 characters; retain across releases.
US_SOULMATE_RECEIPT_SECRET=

# Dedicated generation keys. Email uses existing BREVO_API_KEY/BREVO_SENDER_EMAIL; workers use CRON_SECRET.
# Activation is controlled in src/lib/us-soulmate-automation.ts, not environment variables.
US_SOULMATE_KIE_API_KEY=
US_SOULMATE_ANTHROPIC_API_KEY=

# Optional dedicated advertising/analytics properties; no existing-flow fallback.
NEXT_PUBLIC_US_SOULMATE_META_PIXEL_ID=
US_SOULMATE_META_CAPI_ACCESS_TOKEN=
NEXT_PUBLIC_US_SOULMATE_GA_ID=
US_SOULMATE_GA4_MEASUREMENT_ID=
US_SOULMATE_GA4_API_SECRET=
US_SOULMATE_GA4_PROPERTY_ID=
US_SOULMATE_GOOGLE_SERVICE_ACCOUNT_EMAIL=
US_SOULMATE_GOOGLE_PRIVATE_KEY=
NEXT_PUBLIC_US_SOULMATE_CLARITY_ID=
# Optional independent artwork location. Defaults to the public us-soulmate-lander R2 folder.
NEXT_PUBLIC_US_SOULMATE_ASSET_BASE_URL=
