# Existing browser GA4 tag; use the same stream as GA4_MEASUREMENT_ID.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Server-only GA4 Measurement Protocol credentials. Never use NEXT_PUBLIC_ for the secret.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=

# Optional: true sends purchase to GA4 validation endpoint and logs its response.
# Validation requests are not recorded as purchases in GA4 reports.
GA4_MP_DEBUG=false

# Server-only Meta Conversions API token from Events Manager for NEXT_PUBLIC_META_PIXEL_ID.
# This sends verified PayU purchases to the same dataset as the browser Pixel.
META_CAPI_ACCESS_TOKEN=

# System monitoring (server-only). CRON_SECRET is also used by existing cron routes.
CRON_SECRET=
MONITOR_PUBLIC_URL=https://astrorekha.com
# Fallback recipients used if Supabase is unavailable; UI recipients are stored in Supabase.
MONITOR_ALERT_EMAILS=
MONITOR_SLACK_WEBHOOK_URLS=
# Soulmate-only WhatsApp delivery. Enable after migration and acceptance testing.
# Set an explicit UTC launch timestamp to exclude historical purchases.
SOULMATE_WHATSAPP_ENABLED=false
SOULMATE_WHATSAPP_START_AT=
SOULMATE_AISENSY_INVOICE_CAMPAIGN=soulmate_invoice_delivery_api
SOULMATE_AISENSY_REPORT_CAMPAIGN=soulmate_report_delivery_api
# Uses the existing server-only AISENSY_API_KEY; never expose it to the browser.
# Optional: enables Slack channel/user ID destinations in the admin page.
SLACK_BOT_TOKEN=
